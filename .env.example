# Copiar a .env y completar. Nunca commitear el archivo .env.
# Formato KEY=valor, sin comillas: systemd lo lee tal cual.
SECRET_KEY=cambie-esto-por-una-cadena-larga-y-aleatoria
DEBUG=0
ALLOWED_HOSTS=onto.xz.com.ar
CSRF_TRUSTED_ORIGINS=https://onto.xz.com.ar

SITE_NAME=Onto
SITE_DOMAIN=onto.xz.com.ar
CONTACT_EMAIL=hola@onto.xz.com.ar

# Base de datos (Docker). DB_HOST activa Postgres; sin él se usa SQLite local.
DB_NAME=onto
DB_USER=onto
DB_PASSWORD=cambie-esta-clave

# Motor de IA: cualquier endpoint compatible con OpenAI.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
AI_MAX_TOKENS=4000
AI_TIMEOUT=120

# Precio por millón de tokens, para calcular el costo de cada informe.
AI_PRICE_IN=0.40
AI_PRICE_OUT=1.60

# Correo saliente. Sin EMAIL_HOST se usa el backend de consola (los mails van al log).
# Con OCI el remitente debe estar aprobado en la consola de Email Delivery.
EMAIL_HOST=smtp.email.sa-saopaulo-1.oci.oraclecloud.com
EMAIL_PORT=587
EMAIL_HOST_USER=ocid1.user.oc1..xxxx@ocid1.tenancy.oc1..xxxx.mf.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Onto <no-responder@onto.xz.com.ar>

# Mercado Pago (sandbox mientras PAGOS_ACTIVOS=0)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_PUBLIC_KEY=

# 0 = beta sin cobros, acceso por invitación. 1 = pagos activos.
PAGOS_ACTIVOS=0

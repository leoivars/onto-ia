# Copiar a .env y completar. Nunca commitear el archivo .env.
# Formato KEY=valor, sin comillas: systemd lo lee tal cual.
SECRET_KEY=cambie-esto-por-una-cadena-larga-y-aleatoria
DEBUG=0
ALLOWED_HOSTS=onto.zx.com.ar
CSRF_TRUSTED_ORIGINS=https://onto.zx.com.ar

SITE_NAME=Onto
SITE_DOMAIN=onto.zx.com.ar
CONTACT_EMAIL=hola@onto.zx.com.ar

# Base de datos (Docker). DB_HOST activa Postgres; sin él se usa SQLite local.
DB_NAME=onto
DB_USER=onto
DB_PASSWORD=cambie-esta-clave

# Motor de IA: cualquier endpoint compatible con OpenAI.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
AI_MAX_TOKENS=4000
AI_TIMEOUT=120

# Precio por millón de tokens, para calcular el costo de cada informe.
AI_PRICE_IN=0.40
AI_PRICE_OUT=1.60
